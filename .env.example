# Client-side (safe to expose — these are public by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SERVER-SIDE ONLY. Set this in the Netlify UI, not in a committed file.
# Deliberately no VITE_ prefix: that prefix inlines a value into the browser
# bundle, which would expose the key to anyone who views source.
ANTHROPIC_API_KEY=sk-ant-...
