# Copy this file to .env for local development
# Add these as environment variables in Netlify → Site settings → Environment variables

# Required — Supabase (get from supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — enables AI-powered transaction categorisation
# Get from console.anthropic.com → API Keys
VITE_ANTHROPIC_API_KEY=your-anthropic-key-here
